{
  "name": "nmd",
  "displayName": "NMD - Markdown Preview",
  "description": "Live markdown preview with Shiki syntax highlighting",
  "version": "0.0.1",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nmd.togglePreview",
        "title": "NMD: Toggle Markdown Preview"
      }
    ],
    "keybindings": [
      {
        "command": "nmd.togglePreview",
        "key": "ctrl+shift+m",
        "when": "editorFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
