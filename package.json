{
  "publisher": "AndreiGordienkov",
  "name": "nmd",
  "displayName": "NMD - Markdown Preview",
  "description": "Live markdown preview with Shiki syntax highlighting",
  "version": "1.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "nmd.markdownPreview",
        "displayName": "NMD Markdown Preview",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "nmd.togglePreview",
        "title": "NMD: Toggle Markdown Preview"
      }
    ],
    "keybindings": [
      {
        "command": "nmd.togglePreview",
        "key": "ctrl+shift+m",
        "when": "editorFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
